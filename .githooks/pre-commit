#!/bin/sh
# Runs the quick test tier before every commit.
# Enable once per clone:  git config core.hooksPath .githooks
# Skip in an emergency:   git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1

# Only Python and data changes need the suite.
if ! git diff --cached --name-only | grep -qE '\.py$'; then
  exit 0
fi

echo "pre-commit: running the quick test tier (python3 run_tests.py)..."
if ! python3 run_tests.py; then
  echo
  echo "pre-commit: tests failed - commit aborted."
  echo "Fix the failures, or run 'git commit --no-verify' if you really must."
  exit 1
fi
